      {
        "when": [
          "gui",
          "ground",
          "on_shelf",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "scythe:item/netherite_scythe_gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "scythe:item/netherite_scythe"
    }
  },
  "hand_animation_on_swap": true
}